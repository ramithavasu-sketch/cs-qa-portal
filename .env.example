# ---- Frontend (safe to expose: public anon key only; data is protected by RLS)
VITE_DATA_MODE=supabase            # 'supabase' for production, 'demo' for the fictional demo
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_IDLE_TIMEOUT_MINUTES=30       # automatic sign-out after inactivity

# ---- Edge Function secrets (set with `supabase secrets set ...`, NEVER in the frontend)
# SUPABASE_SERVICE_ROLE_KEY is provided to Edge Functions automatically by Supabase.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'   # sheets-sync
# GOOGLE_SHEET_ID=<your-sheet-id>      # audit responses sheet
# GOOGLE_SHEET_GID=<your-tab-gid>                                     # tab (the number after #gid= in the sheet link)
# GOOGLE_SHEET_RANGE='Form Responses 1'                            # alternative: tab name
# SHEET_TIMEZONE_OFFSET=+05:30                                     # timezone of the form timestamps
# PUBLISH_NEW_PERIODS=false                                        # new weeks start as draft until QA publishes
# EMAIL_PROVIDER=smtp                                              # smtp (default) or resend
# EMAIL_FROM='Your Name <you@example.com>'
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=465                          # Google Workspace SMTP (port 465; Supabase blocks 25/587)
# SMTP_USER=you@example.com  SMTP_PASSWORD=<app password>
# RESEND_API_KEY=...                                               # only if EMAIL_PROVIDER=resend
# CRON_SECRET=...                                                  # shared secret for scheduled invocations
